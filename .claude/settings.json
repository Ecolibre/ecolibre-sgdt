{
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.cookies.txt)",
      "Read(//**/ecolibre-sgdt-prive/.env)",
      "Read(//**/ecolibre-sgdt-prive/.cookies.txt)",
      "Edit(//**/ecolibre-sgdt-prive/.env)",
      "Edit(//**/ecolibre-sgdt-prive/.cookies.txt)",
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(mysql:*)",
      "Bash(mysqldump:*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.cookies.txt)",
      "Read(./Serveur3/**)",
      "Edit(./Serveur3/**)",
      "Read(~/.ssh/**)",
      "Read(//**/miroir-wiki/**/LocalSettings.php)",
      "Read(//**/miroir-wiki/*.sql.gz)",
      "Read(//**/miroir-wiki/*.sql)",
      "Read(//**/miroir-wiki/*.env)",
      "Read(//**/miroir-wiki/**/*.env)",
      "Edit(//**/miroir-wiki/*.env)",
      "Read(//**/miroir-wiki/**/*.sql)",
      "Read(//**/miroir-wiki/**/*.sql.gz)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)"
    ],
    "allow": [
      "Bash(bin/wiki-get.sh:*)",
      "Bash(bin/wiki-put.sh:*)",
      "Bash(bin/wiki-append.sh:*)",
      "Bash(bin/wiki-move.sh:*)",
      "Bash(bin/wiki-purge.sh:*)",
      "Bash(bin/wiki-api.sh:*)",
      "Bash(bin/wiki-login.sh:*)",
      "Bash(bin/wiki-wait-jobs.sh:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(git push:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(bin/wiki-verify.sh:*)",
      "Bash(bin/wiki-warnings.sh:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(od:*)",
      "WebFetch(domain:wiki.ecolibre.org)",
      "Bash(awk:*)",
      "Bash(git fetch:*)",
      "Bash(git check-ignore:*)",
      "WebFetch(domain:www.mediawiki.org)",
      "WebFetch(domain:www.wikidata.org)",
      "WebSearch",
      "Bash(docker:*)",
      "Bash(git rev-list:*)",
      "Bash(git show:*)",
      "Bash(cut:*)",
      "Bash(tee:*)",
      "Read(~/data/Ecolibre/local/miroir-wiki/coeur/**)",
      "Edit(~/data/Ecolibre/local/miroir-wiki/coeur/**)"
    ]
  }
}
