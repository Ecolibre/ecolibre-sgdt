<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
    xmlns="http://virtual-assembly.org/QualityQuantityUnit#"
    xmlns:xsp="http://www.owl-ontologies.com/2005/08/07/xsp.owl#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
    xmlns:swrl="http://www.w3.org/2003/11/swrl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xml:base="http://virtual-assembly.org/QualityQuantityUnit">
  <owl:Ontology rdf:about=""/>
  <owl:Class rdf:ID="QualityConcept">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="QualityQuantityAndUnitConcept"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="DimensionalQuantity">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom>
          <owl:Class rdf:ID="DimensionalUnit"/>
        </owl:allValuesFrom>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="hasUnit"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="BaseQuantity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="DimensionlessUnit">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="unitOf"/>
        </owl:onProperty>
        <owl:allValuesFrom>
          <owl:Class rdf:ID="DimensionlessQuantity"/>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="BaseUnit"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="QuantityExponentiation">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom>
          <owl:Class rdf:ID="DerivedQuantity"/>
        </owl:allValuesFrom>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="defines"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#defines"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom>
          <owl:Class rdf:about="#BaseQuantity"/>
        </owl:allValuesFrom>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="hasBase"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasBase"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="QuantityConcept"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#DimensionalUnit">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#unitOf"/>
        </owl:onProperty>
        <owl:allValuesFrom rdf:resource="#DimensionalQuantity"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="baseOf"/>
        </owl:onProperty>
        <owl:allValuesFrom>
          <owl:Class rdf:ID="MultipliedAndDividedUnit"/>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#BaseUnit"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="ReferenceUnit">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#unitOf"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#unitOf"/>
        </owl:onProperty>
        <owl:allValuesFrom>
          <owl:Class rdf:ID="Quantity"/>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="hasMultiple"/>
        </owl:onProperty>
        <owl:allValuesFrom>
          <owl:Class rdf:about="#MultipliedAndDividedUnit"/>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Unit"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="PerceptionMode">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="allowPerceptionOf"/>
        </owl:onProperty>
        <owl:allValuesFrom>
          <owl:Class rdf:ID="BaseQuality"/>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#QualityConcept"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#baseOf"/>
        </owl:onProperty>
        <owl:allValuesFrom>
          <owl:Class rdf:about="#BaseQuality"/>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#BaseQuality">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="perceivedThrough"/>
        </owl:onProperty>
        <owl:allValuesFrom rdf:resource="#PerceptionMode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class rdf:about="#BaseQuantity"/>
              <owl:Class rdf:about="#DerivedQuantity"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="quantifiedBy"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#QualityConcept"/>
  </owl:Class>
  <owl:Class rdf:about="#BaseUnit">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#unitOf"/>
        </owl:onProperty>
        <owl:allValuesFrom>
          <owl:Class rdf:about="#BaseQuantity"/>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#ReferenceUnit"/>
  </owl:Class>
  <owl:Class rdf:about="#MultipliedAndDividedUnit">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="multipleOf"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom rdf:resource="#ReferenceUnit"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#multipleOf"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#Unit"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasBase"/>
        </owl:onProperty>
        <owl:allValuesFrom rdf:resource="#DimensionalUnit"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasBase"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Quantity">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="quantifies"/>
        </owl:onProperty>
        <owl:allValuesFrom rdf:resource="#BaseQuality"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasUnit"/>
        </owl:onProperty>
        <owl:allValuesFrom rdf:resource="#ReferenceUnit"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasUnit"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#QuantityConcept"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#DimensionlessQuantity">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom rdf:resource="#DimensionlessUnit"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasUnit"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#BaseQuantity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Unit">
    <rdfs:subClassOf rdf:resource="#QualityQuantityAndUnitConcept"/>
  </owl:Class>
  <owl:Class rdf:about="#QuantityConcept">
    <rdfs:subClassOf rdf:resource="#QualityQuantityAndUnitConcept"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    ></rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#BaseQuantity">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom rdf:resource="#BaseUnit"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasUnit"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Quantity"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom rdf:resource="#QuantityExponentiation"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#baseOf"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#DerivedQuantity">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom>
          <owl:Class rdf:ID="DerivedUnit"/>
        </owl:allValuesFrom>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#hasUnit"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#Quantity"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="definedBy"/>
        </owl:onProperty>
        <owl:allValuesFrom rdf:resource="#QuantityExponentiation"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#DerivedUnit">
    <rdfs:subClassOf rdf:resource="#ReferenceUnit"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#unitOf"/>
        </owl:onProperty>
        <owl:allValuesFrom rdf:resource="#DerivedQuantity"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:ObjectProperty rdf:about="#defines">
    <rdfs:domain rdf:resource="#QuantityExponentiation"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="#definedBy"/>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#allowPerceptionOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="#perceivedThrough"/>
    </owl:inverseOf>
    <rdfs:domain rdf:resource="#PerceptionMode"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#quantifiedBy">
    <rdfs:domain rdf:resource="#BaseQuality"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="#quantifies"/>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#perceivedThrough">
    <rdfs:domain rdf:resource="#BaseQuality"/>
    <owl:inverseOf rdf:resource="#allowPerceptionOf"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#unitOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="#hasUnit"/>
    </owl:inverseOf>
    <rdfs:domain rdf:resource="#ReferenceUnit"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#definedBy">
    <owl:inverseOf rdf:resource="#defines"/>
    <rdfs:domain rdf:resource="#DerivedQuantity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasUnit">
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#DimensionalQuantity"/>
          <owl:Class rdf:about="#Quantity"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <owl:inverseOf rdf:resource="#unitOf"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#multipleOf">
    <rdfs:domain rdf:resource="#MultipliedAndDividedUnit"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="#hasMultiple"/>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#baseOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="#hasBase"/>
    </owl:inverseOf>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#DimensionalUnit"/>
          <owl:Class rdf:about="#PerceptionMode"/>
          <owl:Class rdf:about="#BaseQuantity"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#quantifies">
    <rdfs:domain rdf:resource="#Quantity"/>
    <owl:inverseOf rdf:resource="#quantifiedBy"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasBase">
    <owl:inverseOf rdf:resource="#baseOf"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#MultipliedAndDividedUnit"/>
          <owl:Class rdf:about="#QuantityExponentiation"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#hasMultiple">
    <owl:inverseOf rdf:resource="#multipleOf"/>
    <rdfs:domain rdf:resource="#ReferenceUnit"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:ID="coefficient">
    <rdfs:domain rdf:resource="#MultipliedAndDividedUnit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="symbol">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Unit"/>
          <owl:Class rdf:about="#Quantity"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="exponent">
    <rdfs:domain rdf:resource="#QuantityExponentiation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="description">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#QualityQuantityAndUnitConcept"/>
  </owl:DatatypeProperty>
  <DerivedQuantity rdf:ID="electricInductance">
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >inductance électrique</rdfs:label>
  </DerivedQuantity>
  <PerceptionMode rdf:ID="BaseQuality_8">
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Ouïe</rdfs:label>
  </PerceptionMode>
  <QuantityExponentiation rdf:ID="QuantityExponentiation_9">
    <hasBase>
      <DimensionalQuantity rdf:ID="time">
        <symbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >T</symbol>
        <hasUnit>
          <DimensionalUnit rdf:ID="second">
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >seconde</rdfs:label>
            <hasMultiple>
              <MultipliedAndDividedUnit rdf:ID="MultipliedAndDividedUnit_42">
                <coefficient rdf:datatype="http://www.w3.org/2001/XMLSchema#float"
                >60.0</coefficient>
                <multipleOf rdf:resource="#second"/>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >minute</rdfs:label>
                <symbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >min</symbol>
              </MultipliedAndDividedUnit>
            </hasMultiple>
            <hasMultiple>
              <MultipliedAndDividedUnit rdf:ID="MultipliedAndDividedUnit_43">
                <multipleOf rdf:resource="#second"/>
                <symbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >h</symbol>
                <coefficient rdf:datatype="http://www.w3.org/2001/XMLSchema#float"
                >3600.0</coefficient>
                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >heure</rdfs:label>
              </MultipliedAndDividedUnit>
            </hasMultiple>
            <symbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >s</symbol>
            <unitOf rdf:resource="#time"/>
          </DimensionalUnit>
        </hasUnit>
        <baseOf rdf:resource="#QuantityExponentiation_9"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >temps</rdfs:label>
      </DimensionalQuantity>
    </hasBase>
    <exponent rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
    >-1</exponent>
    <defines>
      <DerivedQuantity rdf:ID="velocity">
        <hasUnit>
          <DerivedUnit rdf:ID="metrePerSecond">
            <unitOf rdf:resource="#velocity"/>
            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >mètre par seconde</rdfs:label>
            <symbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >m.s-1</symbol>
          </DerivedUnit>
        </hasUnit>
        <definedBy>
          <QuantityExponentiation rdf:ID="QuantityExponentiation_8">
            <defines rdf:resource="#velocity"/>
            <exponent rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >1</exponent>
            <hasBase>
              <DimensionalQuantity rdf:ID="length">
                <symbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >L</symbol>
                <baseOf>
                  <QuantityExponentiation rdf:ID="QuantityExponentiation_6">
                    <defines>
                      <DerivedQuantity rdf:ID="surface">
                        <quantifies>
                          <BaseQuality rdf:ID="Quality_23">
                            <quantifiedBy>
                              <DerivedQuantity rdf:ID="volume">
                                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >volume</rdfs:label>
                                <hasUnit>
                                  <DerivedUnit rdf:ID="cubicMetre">
                                    <unitOf rdf:resource="#volume"/>
                                    <rdfs:label rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >mètre cube</rdfs:label>
                                    <symbol rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                    >m3</symbol>
                                  </DerivedUnit>
                                </hasUnit>
                                <definedBy>
                                  <QuantityExponentiation rdf:ID="QuantityExponentiation_7">
                                    <hasBase rdf:resource="#length"/>
                                    <defines rdf:resource="#volume"/>
                                    <exponent rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                                    >3</exponent>
                                  </QuantityExponentiation>
                                </definedBy>
                                <quantifies rdf:resource="#Quality_23"/>
                              </DerivedQuantity>
                            </quantifiedBy>
                            <quantifiedBy rdf:resource="#surface"/>
                            <quantifiedBy rdf:resource="#length"/>
                            <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                            >Forme</rdfs:label>
                            <perceivedThrough>
                              <PerceptionMode rdf:ID="BaseQuality_5">
                                <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                                >Toucher</rdfs:label>
                                <allowPerceptionOf>
                                  <BaseQuality rdf:ID="BaseQuality_10">
                                    <rdfs:label rdf:datatype=
                                    "http://www.w3.org/2001/XMLSchema#string"
                                    >Texture</rdfs:label>
                                    <perceivedThrough rdf:resource="#BaseQuality_5"/>
                                    <perceivedThrough>
                                      <PerceptionMode rdf:ID="BaseQuality_4">
                                        <rdfs:label rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#string"
                                        >Vue</rdfs:label>
                                        <allowPerceptionOf rdf:resource="#BaseQuality_10"/>
                                        <allowPerceptionOf rdf:resource="#Quality_23"/>
                                        <allowPerceptionOf>
                                          <BaseQuality rdf:ID="Quality_22">
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
                                            >Matière</rdfs:label>
                                            <perceivedThrough>
                                              <PerceptionMode rdf:ID="BaseQuality_6">
                                                <allowPerceptionOf rdf:resource="#Quality_22"/>
                                                <rdfs:label rdf:datatype=
                                                "http://www.w3.org/2001/XMLSchema#string"
                                                >Goût</rdfs:label>
                                              </PerceptionMode>
                                            </perceivedThrough>
                                            <perceivedThrough rdf:resource="#BaseQuality_5"/>
                                            <perceivedThrough rdf:resource="#BaseQuality_4"/>
                                            <perceivedThrough>
                                              <PerceptionMode rdf:ID="BaseQuality_7">
                                                <allowPerceptionOf rdf:resource="#Quality_22"/>
                                                <rdfs:label rdf:datatype=
                                                "http://www.w3.org/2001/XMLSchema#string"
                                                >Odeur</rdfs:label>
                                              </PerceptionMode>
                                            </perceivedThrough>
                                          </BaseQuality>
                                        </allowPerceptionOf>
                                        <allowPerceptionOf>
                                          <BaseQuality rdf:ID="DerivedQuality_3">
                                            <perceivedThrough rdf:resource="#BaseQuality_4"/>
                                            <rdfs:label rdf:datatype=
                                            "http://www.w3.org/2001/XMLSchema#string"
